# Copy to .env for local development. Never commit .env. Production values are Fly secrets/env (fly.toml).
NODE_ENV=development
PORT=8080
AGAPE_DATABASE_PATH=var/agape.db
AGAPE_PUBLIC_URL=http://localhost:8080
# Additional origins allowed to submit forms, comma-separated (e.g. the fly.dev hostname)
AGAPE_EXTRA_ORIGINS=
# true only behind a trusted proxy (Fly.io): client IP is read from Fly-Client-IP
AGAPE_TRUST_PROXY=false

# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
# Signs CSRF tokens, derives emergency access tokens and keys the IP hash. Rotating it
# signs everyone out of open forms and invalidates emergency recovery links.
AGAPE_SECRET=

# off | pilot. Keep off until volunteer staffing and alert delivery are confirmed.
AGAPE_EMERGENCY_MODE=off
AGAPE_EMERGENCY_RESPONDER_MIN_ACCOUNT_AGE_HOURS=24

# Web Push (optional). Generate with: npm run build && node dist/cli.js generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for push services
VAPID_SUBJECT=

# Email notifications (optional), any SMTP provider: smtps://user:pass@smtp.example.org:465
SMTP_URL=
SMTP_FROM=

LOG_LEVEL=info
