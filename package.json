{
  "name": "omh-agape",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-vendor.mjs",
    "start": "node dist/server.js",
    "dev": "node scripts/copy-vendor.mjs && tsx watch src/server.ts",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:zcta": "node scripts/build-zcta.mjs"
  },
  "author": "Open Mission of Hope",
  "license": "Apache-2.0",
  "description": "OMH Agape: voluntary, person-to-person help. Help freely asked. Help freely given.",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "leaflet": "^1.9.4",
    "nodemailer": "^10.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmissionofhope/agape.git"
  },
  "engines": {
    "node": ">=22.12"
  }
}
